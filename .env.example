# Clairveil DApp environment overrides.
# Copy to .env when you want shell-managed local overrides:
#   cp .env.example .env
#   set -a; source .env; set +a
#   npm start
#
# server.js still has safe local defaults, so you only need to set values
# that differ from the default local Clairveil profile.

# DApp server
CLAIRVEIL_DAPP_HOST=127.0.0.1
CLAIRVEIL_DAPP_PORT=5173
CLAIRVEIL_DAPP_LOCAL_TEST_MODE=1
# Required when local-test mode is disabled. This must be the final HTTPS
# browser origin with no path, query, credentials, or fragment.
CLAIRVEIL_DAPP_PUBLIC_ORIGIN=

# Local helper access.
# Keep these disabled unless you intentionally expose local-test helpers on LAN.
CLAIRVEIL_DAPP_ALLOW_LAN_SIGNING=0
CLAIRVEIL_DAPP_ALLOW_LAN_ADMIN=0

# Clairveil node / local CLI
# EVM local-test mode: configure these BEFORE setting LOCAL_TEST_MODE=1.
# Browser bootstrap can recover bundled public dev0..dev3 test keys if no
# recognized signer is found. Use an isolated disposable keyring, never a
# personal/production wallet home. The CLI must support eth_secp256k1 key
# recovery and the sample's local helper commands.
# CLAIRVEILD_BIN=/absolute/path/to/chain-cli
# CLAIRVEIL_HOME=/absolute/path/to/disposable-test-home
# CLAIRVEIL_LOCAL_SIGNER_BIN=/absolute/path/to/chain-cli
# CLAIRVEIL_LOCAL_SIGNER_HOME=/absolute/path/to/disposable-test-home
# CLAIRVEIL_LOCAL_SIGNER_KEYRING=test
# Optional separate keyring home containing the local test `auditor` key.
# Its disclosure public key must match the chain audit config; never use production custody keys.
# CLAIRVEIL_AUDITOR_HOME=/absolute/path/to/disposable-auditor-home
# Omit unused overrides rather than setting them to an empty string.
CLAIRVEIL_HOME=/tmp/clairveil-dapp-local
CHAIN_ID=clairveil-local-2
CLAIRVEILD_BIN=clairveild
CLAIRVEIL_RPC=tcp://127.0.0.1:26657
CLAIRVEIL_REST=http://127.0.0.1:1317

# Browser-visible node endpoints.
# Leave empty to reuse CLAIRVEIL_RPC / CLAIRVEIL_REST.
CLAIRVEIL_PUBLIC_RPC=
CLAIRVEIL_PUBLIC_REST=
# Optional comma-separated REST failover list exposed in the active browser
# profile. The primary CLAIRVEIL_PUBLIC_REST is added automatically. Every
# entry needs the production CORS policy and is added to this server's CSP.
CLAIRVEIL_PUBLIC_REST_ENDPOINTS=
# Optional profile-specific, schema-compatible REST failover lists shown in
# the note recovery selector. They override the generic list when the matching
# Cosmos or EVM-host profile is active.
CLAIRVEIL_COSMOS_REST_ENDPOINTS=
CLAIRVEIL_EVM_HOST_REST_ENDPOINTS=

# Prover
CLAIRVEIL_PROVER_URL=http://127.0.0.1:8080
CLAIRVEIL_PUBLIC_PROVER_URL=http://127.0.0.1:8080
# Optional reviewed browser-visible legacy EVM/product deposit proof endpoint.
# Cosmos derives the canonical /v1/prover/deposit route from proverUrl unless
# CLAIRVEIL_COSMOS_DEPOSIT_PROOF_URL is set explicitly.
CLAIRVEIL_PUBLIC_DEPOSIT_PROOF_URL=
# Cosmos expects the canonical Core v0.4.0 V1 wire at its exact override;
# EVM keeps the existing product-specific provider contract.
CLAIRVEIL_COSMOS_DEPOSIT_PROOF_URL=
CLAIRVEIL_EVM_DEPOSIT_PROOF_URL=
# Optional DApp-proxy override. When blank, the proxy uses the common proverd
# credential below; neither credential is ever exposed in browser config.
CLAIRVEIL_PROVER_BEARER_TOKEN=
CLAIRVEIL_PRIVACY_PROVER_BEARER_TOKEN=
CLAIRVEIL_PROVER_TIMEOUT_MS=120000
# The bundled proxy is local-test-only and always loopback-only.
CLAIRVEIL_PROVER_PROXY_ENABLED=1
CLAIRVEIL_PROVER_PROXY_RATE_LIMIT_WINDOW_MS=60000
CLAIRVEIL_PROVER_PROXY_RATE_LIMIT_MAX=30
CLAIRVEIL_PROVER_PROXY_MAX_IN_FLIGHT=2
# Positive byte limit applied independently to the raw wire body and, for gzip,
# the decompressed request body. The default is 8 MiB.
CLAIRVEIL_PROVER_PROXY_MAX_REQUEST_BYTES=8388608
CLAIRVEIL_PROVER_PROXY_MAX_RESPONSE_BYTES=1048576
# Optional server-only canonical Cosmos deposit prover base. The local proxy
# appends /v1/prover/deposit and never exposes this upstream URL in browser
# config. Omit it to use CLAIRVEIL_PROVER_URL for all canonical proof routes.
CLAIRVEIL_COSMOS_DEPOSIT_PROVER_URL=

# Server-side health/read gateway bounds.
CLAIRVEIL_DAPP_UPSTREAM_TIMEOUT_MS=10000
CLAIRVEIL_DAPP_UPSTREAM_MAX_RESPONSE_BYTES=1048576
CLAIRVEIL_DAPP_HEALTH_MAX_IN_FLIGHT=8

# Optional exact legacy EVM/product DepositCircuit service used by the local
# /v1/prover/deposit-legacy proxy. The canonical Cosmos proxy instead derives
# /v1/prover/deposit from CLAIRVEIL_PROVER_URL.
CLAIRVEIL_DEPOSIT_PROOF_URL=

# Chain profile
CLAIRVEIL_TRANSPORT=cosmos
CLAIRVEIL_DENOM=uclair
CLAIRVEIL_DISPLAY_DENOM=CLAIR
CLAIRVEIL_COIN_DECIMALS=18
CLAIRVEIL_ACCOUNT_PREFIX=clair
CLAIRVEIL_SHIELDED_PREFIX=clairs
CLAIRVEIL_GAS_PRICES=1uclair

# Keplr / Cosmos profile
# Optional profile-specific browser endpoints. These take precedence over the
# shared CLAIRVEIL_PUBLIC_RPC / CLAIRVEIL_PUBLIC_REST values.
CLAIRVEIL_COSMOS_RPC=
CLAIRVEIL_COSMOS_REST=
CLAIRVEIL_COSMOS_CHAIN_ID=
CLAIRVEIL_COSMOS_CHAIN_NAME="Clairveil Localnet"
# Optional DApp selector label. Blank values inherit CLAIRVEIL_COSMOS_CHAIN_NAME.
CLAIRVEIL_COSMOS_LABEL=
CLAIRVEIL_COSMOS_DENOM=
# Optional display metadata overrides. Blank values inherit the shared profile
# metadata above.
CLAIRVEIL_COSMOS_DISPLAY_DENOM=
CLAIRVEIL_COSMOS_COIN_DECIMALS=
# These identity overrides are shared by the browser profile and the server's
# local Cosmos signer/client when Cosmos is active.
CLAIRVEIL_COSMOS_ACCOUNT_PREFIX=
CLAIRVEIL_COSMOS_SHIELDED_PREFIX=
CLAIRVEIL_COSMOS_COIN_TYPE=
# Backward-compatible coin-type alias used when CLAIRVEIL_COSMOS_COIN_TYPE is blank.
CLAIRVEIL_KEPLR_COIN_TYPE=118
CLAIRVEIL_KEPLR_GAS_LOW=1
CLAIRVEIL_KEPLR_GAS_AVERAGE=1
CLAIRVEIL_KEPLR_GAS_HIGH=1

# Optional EVM / MetaMask profile
CLAIRVEIL_EVM_DENOM=
CLAIRVEIL_EVM_RPC=http://127.0.0.1:8545
CLAIRVEIL_EVM_CHAIN_ID=815
CLAIRVEIL_EVM_CHAIN_NAME="EVM Localnet"
# Required when CLAIRVEIL_TRANSPORT=evm. This is deployment/profile metadata;
# the Web app does not assume a chain-specific precompile address.
CLAIRVEIL_EVM_PRIVACY_PRECOMPILE=
CLAIRVEIL_EVM_DEPOSIT_MODE=nonpayable
CLAIRVEIL_EVM_NATIVE_DENOM=utoken
CLAIRVEIL_EVM_GAS_LIMIT=0x989680
CLAIRVEIL_EVM_SEND_GAS_LIMIT=0x5208
