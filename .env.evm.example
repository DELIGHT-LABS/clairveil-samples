# Copy ONE transport example to .env, edit it, then run:
#   cp .env.cosmos.example .env   # or .env.evm.example
#   set -a; source .env; set +a
#   npm start
# Restart from a fresh shell when switching transport to avoid old exports.
# Public-chain defaults: HTTPS endpoints, no local keyring/faucet/admin helpers.
CLAIRVEIL_DAPP_HOST=127.0.0.1
CLAIRVEIL_DAPP_PORT=5173
CLAIRVEIL_DAPP_LOCAL_TEST_MODE=0
# EVM local-test mode: configure these BEFORE setting LOCAL_TEST_MODE=1.
# Browser bootstrap can recover bundled public dev0..dev3 test keys if no
# recognized signer is found. Use an isolated disposable keyring, never a
# personal/production wallet home. The CLI must support eth_secp256k1 key
# recovery and the sample's local helper commands.
# CLAIRVEILD_BIN=/absolute/path/to/chain-cli
# CLAIRVEIL_HOME=/absolute/path/to/disposable-test-home
# CLAIRVEIL_LOCAL_SIGNER_BIN=/absolute/path/to/chain-cli
# CLAIRVEIL_LOCAL_SIGNER_HOME=/absolute/path/to/disposable-test-home
# CLAIRVEIL_LOCAL_SIGNER_KEYRING=test
# Optional separate keyring home with `auditor` matching the chain audit public key.
# CLAIRVEIL_AUDITOR_HOME=/absolute/path/to/disposable-auditor-home
# Omit unused overrides rather than setting them to an empty string.
CLAIRVEIL_DAPP_PUBLIC_ORIGIN=https://app.example.com
CLAIRVEIL_PROVER_PROXY_ENABLED=0
CLAIRVEIL_DAPP_ALLOW_LAN_SIGNING=0
CLAIRVEIL_DAPP_ALLOW_LAN_ADMIN=0
CLAIRVEIL_PROVER_BEARER_TOKEN=
CLAIRVEIL_PRIVACY_PROVER_BEARER_TOKEN=

# Chain and browser endpoints (replace all example values).
CHAIN_ID=my-chain-1
CLAIRVEIL_RPC=https://rpc.example.com
CLAIRVEIL_REST=https://rest.example.com
CLAIRVEIL_PROVER_URL=https://prover.example.com
CLAIRVEIL_PUBLIC_RPC=
CLAIRVEIL_PUBLIC_REST=
CLAIRVEIL_PUBLIC_PROVER_URL="$CLAIRVEIL_PROVER_URL"

# Display metadata and host identity.
CLAIRVEIL_DENOM=utoken
CLAIRVEIL_DISPLAY_DENOM=TOKEN
CLAIRVEIL_COIN_DECIMALS=6
CLAIRVEIL_ACCOUNT_PREFIX=my
CLAIRVEIL_SHIELDED_PREFIX=mys

CLAIRVEIL_TRANSPORT=evm
# EIP-155 ID differs from the host CHAIN_ID above.
CLAIRVEIL_EVM_CHAIN_ID=4660
CLAIRVEIL_EVM_CHAIN_NAME="My EVM Privacy Chain"
CLAIRVEIL_EVM_RPC=https://evm-rpc.example.com
# EVM-derived host identity; this field must be explicit.
CLAIRVEIL_EVM_PRIVACY_ACCOUNT_PREFIX=my
# Set the actual chain's precompile and supported deposit mode.
CLAIRVEIL_EVM_PRIVACY_PRECOMPILE=0x100000000000000000000000000000000000000b
CLAIRVEIL_EVM_DEPOSIT_MODE=payable-exact-value
CLAIRVEIL_EVM_NATIVE_DENOM=utoken
CLAIRVEIL_EVM_GAS_LIMIT=0x989680
CLAIRVEIL_EVM_SEND_GAS_LIMIT=0x5208
# Exact EVM-compatible deposit provider URL, not an assumed Cosmos route.
CLAIRVEIL_EVM_DEPOSIT_PROOF_URL=https://deposit-proof.example.com/v1/prove
